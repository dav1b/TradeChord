# =============================================================
# TradeChord monorepo ignore rules
# web/  = SvelteKit dashboard (Node)   pipeline/ = data release tool (Python)
# =============================================================

# ---- Node / SvelteKit (web) ----
node_modules/
.svelte-kit/
build/
dist/
.output
.vercel
.netlify
.wrangler
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ---- Python (pipeline) ----
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- Pipeline working data (NEVER committed) ----
data/staging/
data/raw/
pipeline/data/
**/.cache/
*.bin
*.checkpoint*.jsonl
optimized_exports_*.csv
optimized_exports_*.manifest.json
*_matrix_*.csv
*_matrix_*.json

# ---- Committed releases: explicit re-inclusion ----
!data/releases/
!data/releases/**

# ---- Secrets ----
.env
.env.*
!.env.example
!.env.test

# ---- OS ----
.DS_Store
Thumbs.db

# macOS iCloud/Finder name-collision duplicates ("<name> 2.<ext>")
* [0-9].json
* [0-9].ts
* [0-9].svelte
* [0-9].css
* [0-9].py
* [0-9].csv
